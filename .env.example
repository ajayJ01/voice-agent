# =============================================================================
# Copy to ".env" and fill secrets. Never commit ".env".
# Variable reference: README.md (sections on pipelines, tuning, troubleshooting).
# =============================================================================

# --- LiveKit (worker + token server) — required for worker and /token ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the agent name registered in LiveKit Cloud for this worker.
AGENT_NAME=hinglish-voice-agent

# Reject inbound agent jobs for this many seconds after worker process starts.
# Prevents a burst of stale dispatches (queued while worker was down) from spawning
# multiple agents or starving the real browser connect. If your first connect fails,
# refresh the page after the worker is up; widen only when debugging duplicate agents.
# STALE_DISPATCH_DROP_WINDOW_S=1.25

LIVEKIT_ROOM_EMPTY_TIMEOUT_S=300
LIVEKIT_ROOM_MAX_PARTICIPANTS=4
LIVEKIT_TOKEN_TTL_HOURS=2

# --- Deployment (worker + token server) ---
# development | production | prod
# production: token server requires TOKEN_SERVER_CORS_ORIGINS; review PIPELINE_HALT_AFTER_LLM
DEPLOYMENT=development

# --- Deepgram STT — DEEPGRAM_API_KEY required ---
DEEPGRAM_API_KEY=

# latency | balanced | accuracy — sets DEEPGRAM_ENDPOINTING_MS, turn delays,
# stuck-guard, and VAD min_silence defaults unless you override those vars explicitly.
STT_QUALITY_MODE=balanced
DEEPGRAM_MODEL=nova-3

# Streaming language:
# - multi = Hindi+English codeswitching (recommended). Model may still emit es/pt/…
#   on noise; agent.py remaps/drops so only hi/en reach the LLM.
# - hi = Hindi-biased (less Latin junk; pure English may suffer).
# - en / en-IN = English-biased (Devanagari/Hinglish may suffer).
# Nova-3 multi cannot be restricted to exactly two languages via one flag; see
# docs/LANGUAGE_DETECTION_NOTES.md for Flux / migration notes.
DEEPGRAM_LANGUAGE=multi

# Optional override (ms). If unset, STT_QUALITY_MODE preset applies.
# DEEPGRAM_ENDPOINTING_MS=680

DEEPGRAM_NUMERALS=true
DEEPGRAM_MIP_OPT_OUT=true
DEEPGRAM_PROFANITY_FILTER=false
# Leave false: streaming path fixes language from DEEPGRAM_LANGUAGE; true is ignored with a warning.
DEEPGRAM_DETECT_LANGUAGE=false

# Comma-separated keyterms for English STT biasing only. For non-English-prefixed
# DEEPGRAM_LANGUAGE values, agent.py drops keyterms so recognition is not broken.
DEEPGRAM_KEYTERM=

STT_SAMPLE_RATE=48000

# --- LLM (Groq default, or OpenAI-compatible) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.4

OPENAI_API_KEY=
# Optional; omit for provider default when using OpenAI
OPENAI_BASE_URL=

# Optional full system prompt; worker appends short Nyra Hindi + India office disamb. hints if missing.
AGENT_INSTRUCTIONS=

# --- Cartesia TTS — required for VOICE_PIPELINE=stt_llm_tts ---
# livekit-plugins-cartesia reads CARTESIA_API_KEY from the environment.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Default TTS language when turn language is unknown (agent mirrors en/hi per turn).
CARTESIA_LANGUAGE=hi
# Optional playback speed for sonic-3 (0.6–2.0). Matches TTS_SPEED in .env if set.
# TTS_SPEED=1.0

# --- Token server (FastAPI: token_server.py) ---
TOKEN_SERVER_HOST=0.0.0.0
TOKEN_SERVER_PORT=8787
# production: comma-separated exact origins, e.g. https://app.example.com,https://www.example.com
TOKEN_SERVER_CORS_ORIGINS=
# Optional: require X-API-Key or ?api_key= matching this value (constant-time compare).
TOKEN_SERVER_API_KEY=

# --- Voice worker pipeline (agent.py) ---
# stt_llm | stt_llm_tts | stt_only
VOICE_PIPELINE=stt_llm

# STT-only probe: forces stt_only; first final can end session (see STT_TEST_*).
STT_TEST_MODE=false
# Set true only for deliberate canary when DEPLOYMENT=production
STT_ALLOW_TEST_IN_PRODUCTION=false
STT_TEST_DISCONNECT_DELAY_S=0.35
# Brief wait so user message commits before session.aclose in test mode
STT_TEST_COMMIT_FLUSH_S=0.45
STT_TEST_IMMEDIATE_CLOSE_ON_FIRST_FINAL=false
STT_TEST_MAX_WAIT_USER_SILENCE_S=45
STT_TEST_POST_LISTENING_DRAIN_S=0.75
STT_TEST_TRAILING_QUIET_S=0.88
STT_TEST_MAX_TRAILING_WAIT_S=4

# After first assistant reply, close session (one-shot tests only).
PIPELINE_HALT_AFTER_LLM=false
# Stop listening after first STT final (or use with STT_TEST_MODE).
STT_STOP_AFTER_FIRST_FINAL=false

LOG_LEVEL=INFO
LOG_FILE=voice-agent.log
LOG_VAD_METRICS=false
LOG_STT_TURN_TIMING=true
LOG_STT_INTERIM_ALL=true

# Turn handling — defaults follow STT_QUALITY_MODE if unset
# stt | vad | manual | realtime_llm
TURN_DETECTION=stt
# TURN_ENDPOINTING_MIN_DELAY_S=0.24
# TURN_ENDPOINTING_MAX_DELAY_S=1.78

# After a usable STT final, stuck recovery waits for STT idle (optional overrides).
# STT_RECOVERY_MIN_QUIET_S=1.05
# STT_RECOVERY_FRAGMENT_EXTRA_S=0.55

# Stuck-pipeline watchdog (seconds / grace). Tune only after reading logs.
# STUCK_PIPELINE_MAX_WAIT_S=45
# STUCK_PIPELINE_GRACE_AFTER_LISTEN_S=0.75
# STUCK_PIPELINE_MIN_WAIT_AFTER_FINAL_S=2.25

# --- VAD (Silero) — defaults in code if unset: min_speech 0.18s, threshold 0.50 ---
VAD_MIN_SPEECH_DURATION_S=0.18
VAD_MIN_SILENCE_DURATION_S=0.45
VAD_ACTIVATION_THRESHOLD=0.50

# First-user-state watchdog: delay before "no user state" timer window
USER_STATE_WATCH_DELAY_S=1.25

# --- Barge-in / echo (LiveKit AgentSession) ---
# Set to none|off|disable to omit AEC warmup (float seconds otherwise). Default 1.0 in code.
# AEC_WARMUP_DURATION_S=1.0
INTERRUPTION_MIN_DURATION_S=0.35
INTERRUPTION_MIN_WORDS=1
INTERRUPTION_FALSE_TIMEOUT_S=3.5
INTERRUPTION_RESUME_AFTER_FALSE=true
