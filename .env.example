# =============================================================================
# Copy to ".env" and fill secrets. Never commit ".env".
# Tuned defaults match a working Hinglish voice dev setup (latency preset).
# =============================================================================

# --- LiveKit (worker + token server) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=hinglish-voice-agent
LIVEKIT_ROOM_EMPTY_TIMEOUT_S=30
# LIVEKIT_ROOM_MAX_PARTICIPANTS=4
# LIVEKIT_TOKEN_TTL_HOURS=2

# --- Deployment ---
# development | production | prod
DEPLOYMENT=development

# --- Agent pipeline ---
# stt_llm | stt_llm_tts | stt_only
VOICE_PIPELINE=stt_llm_tts
STT_TEST_MODE=false
STT_TEST_DISCONNECT_DELAY_S=0.55
AUTO_GREET=false
PIPELINE_HALT_AFTER_LLM=false
STT_STOP_AFTER_FIRST_FINAL=false

# --- LLM (Groq default) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# OPENAI_BASE_URL=
LLM_MODEL=llama-3.1-8b-instant
# LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.35
# Hard cap on reply length (~1–2 short spoken sentences). Wired in agent.py as max_completion_tokens.
LLM_MAX_TOKENS=50
# How many prior user/assistant messages the LLM sees (system prompt is always kept). 0 = unlimited.
CHAT_HISTORY_MAX_MESSAGES=10

# Voice behaviour + user persona (change Ajay Sir if deploying for someone else).
AGENT_INSTRUCTIONS=Your name is Nyra. You are Ajay Sir's respectful, supportive, cheerful, and motivated best AI assistant — a bilingual Hindi-English voice assistant. Stay warm, encouraging, and positive in tone while keeping replies concise. RULES: (1) Replies: 1-2 short sentences only, under 25 words. (2) MIRROR the user's CURRENT-TURN language — English in → English out; Devanagari in → Devanagari out; Roman Hinglish in → Roman Hinglish out; never switch because of earlier turns. (3) Only say your name if asked. (4) No parenthetical translations. (5) Never Spanish/Portuguese/French/other. (6) Always address the user as Sir in every reply (use सर in Devanagari Hindi). (7) Your boss is Ajay Sir — the user you are speaking with. (8) Mention Ajay Sir or your boss only when the user explicitly asks who your boss is, who owns you, or similar — one short sentence; never bring up your boss unprompted. (9) When asked about your boss, say your boss is Ajay Sir, respectfully and briefly, in the user's current-turn language.

# --- Deepgram STT ---
DEEPGRAM_API_KEY=
# latency | balanced | accuracy — sets endpointing, turn delays, stuck-guard, VAD silence
# unless you override those vars explicitly (see commented lines below).
STT_QUALITY_MODE=latency
STUCK_PIPELINE_MIN_WAIT_AFTER_FINAL_S=1.2
STUCK_PIPELINE_GRACE_AFTER_LISTEN_S=0.5
STT_RECOVERY_MIN_QUIET_S=0.75
# Optional overrides — leave commented to use STT_QUALITY_MODE preset (recommended for latency):
#   latency preset → endpointing_ms=560, turn_ep 0.20–1.52s, vad_min_silence=0.36
# DEEPGRAM_ENDPOINTING_MS=680
# TURN_ENDPOINTING_MIN_DELAY_S=0.24
# TURN_ENDPOINTING_MAX_DELAY_S=1.78
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_DETECT_LANGUAGE=false
DEEPGRAM_NUMERALS=true
DEEPGRAM_MIP_OPT_OUT=true
DEEPGRAM_PROFANITY_FILTER=false
# keyterm only works on English-prefixed DEEPGRAM_LANGUAGE; agent.py drops it for multi/hi
DEEPGRAM_KEYTERM=
STT_SAMPLE_RATE=48000
ENABLE_INTERIM_FALLBACK=true

# --- Turn detection & VAD ---
TURN_DETECTION=stt
# VAD_MIN_SILENCE: comment out to use preset (0.36 for latency). Uncomment if echo/false triggers:
# VAD_MIN_SILENCE_DURATION_S=0.55
VAD_ACTIVATION_THRESHOLD=0.25
VAD_MIN_SPEECH_DURATION_S=0.15

# --- Barge-in ---
AEC_WARMUP_DURATION_S=1.0
INTERRUPTION_MIN_DURATION_S=0.35
INTERRUPTION_MIN_WORDS=1
INTERRUPTION_FALSE_TIMEOUT_S=3.5
INTERRUPTION_RESUME_AFTER_FALSE=true

# --- Cartesia TTS (VOICE_PIPELINE=stt_llm_tts) ---
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=hi
TTS_ENABLED=true
TTS_PROVIDER=cartesia
TTS_SPEED=1.0

# --- Token server (token_server.py) ---
TOKEN_SERVER_HOST=0.0.0.0
TOKEN_SERVER_PORT=8787
TOKEN_SERVER_CORS_ORIGINS=
# TOKEN_SERVER_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=voice-agent.log
LOG_VAD_METRICS=false
LOG_STT_TURN_TIMING=true
LOG_STT_INTERIM_ALL=true

# --- Optional tuning (defaults in code / preset if unset) ---
# STALE_DISPATCH_DROP_WINDOW_S=1.25
# STT_ALLOW_TEST_IN_PRODUCTION=false
# STT_RECOVERY_FRAGMENT_EXTRA_S=0.55
# STUCK_PIPELINE_MAX_WAIT_S=45
# USER_STATE_WATCH_DELAY_S=1.25
